# Skylark の設定例 このファイルを .env にコピーして使う
# .env は Git の管理対象外 パスワードなどの秘密情報はここへ書かない

# ---- PostgreSQL ----
# 接続文字列 指定すると下の個別項目より優先される(記号を含むパスワードはURLエンコードが必要)
#DATABASE_URL=postgres://skylark:PASSWORD@localhost:5432/skylark
POSTGRES_HOSTNAME=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=skylark
# パスワードの既定値は無い 必ず設定する
POSTGRES_PASSWORD=
POSTGRES_DATABASE=skylark

# 接続プール(省略時の値)
#DB_POOL_SIZE=16
# 接続を使い回す最大秒数
#DB_POOL_RECYCLE=3600
# 空き接続を閉じるまでの秒数
#DB_IDLE_TIMEOUT=30
# 接続確立のタイムアウト秒
#DB_POOL_TIMEOUT=30

# ---- スクレイピング ----
# HTTPリクエストのタイムアウト秒
#HTTP_TIMEOUT=5
# 同時ダウンロード数
#MAX_CONCURRENT_REQUESTS=16
# netkeibaのログイン情報(任意)
#NETKEIABA_LOGINID=
#NETKEIABA_PASSWORD=

# ---- Web UI ----
# 待ち受けアドレス 既定は自分のPCからのみ 認証が無いため 変更する場合は十分に注意する
#WEBUI_HOST=127.0.0.1
#WEBUI_PORT=8501
# Playwrightが管理するブラウザの代わりに使うChromiumの実行ファイル
#CHROMIUM_EXECUTABLE_PATH=
