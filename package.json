{
    "name": "skylark",
    "version": "0.1.0",
    "description": "Skylark - 雲雀(競馬予測素体作成)",
    "private": true,
    "type": "module",
    "license": "MIT",
    "author": "MINETA \"m10i\" Hiroki <h-mineta@0nyx.net>",
    "packageManager": "pnpm@11.10.0",
    "engines": {
        "bun": ">=1.3.0"
    },
    "scripts": {
        "start": "bun run src/cli.ts",
        "build:webui": "bun run scripts/build-webui.ts",
        "webui": "bun run build:webui && bun run src/webui/server.tsx",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "format": "biome format --write .",
        "test": "bun test",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "cheerio": "^1.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cn": "^0.5.0",
        "domhandler": "^5.0.3",
        "dotenv": "^18.0.8",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.13.13",
        "lucide-react": "^1.58.0",
        "playwright": "^1.64.1",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@electric-sql/pglite": "^0.5.10",
        "@types/bun": "^1.4.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "bun-plugin-tailwind": "^0.1.2",
        "drizzle-kit": "^0.31.11",
        "pg": "^8.23.1",
        "shadcn": "^4.22.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2"
    }
}
